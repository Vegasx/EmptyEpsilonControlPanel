<Application x:Class="Epsilon.Native.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Epsilon.Native">
  <Application.Resources>
    <Style TargetType="local:GripSlider">
      <Setter Property="Focusable" Value="True"/><Setter Property="IsTabStop" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="local:GripSlider">
          <Grid x:Name="PART_Surface" Background="Transparent" ClipToBounds="False">
            <Grid x:Name="PART_Rail" Margin="32,0">
              <Border Height="13" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="1" BorderBrush="#55200F0A" BorderThickness="0,2,0,0"/>
              <Border x:Name="PART_Fill" Height="13" VerticalAlignment="Center" Background="{TemplateBinding Foreground}" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform></Border>
              <UniformGrid Columns="3" Margin="0,8"><Border BorderBrush="#406F5638" BorderThickness="1,0,0,0"/><Border BorderBrush="#406F5638" BorderThickness="1,0,0,0"/><Border BorderBrush="#406F5638" BorderThickness="1,0,1,0"/></UniformGrid>
            </Grid>
            <Image x:Name="PART_Grip" Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="LowQuality"><Image.RenderTransform><TranslateTransform/></Image.RenderTransform></Image>
          </Grid>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="PlainButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><Border x:Name="FocusRing" BorderBrush="#46301E" BorderThickness="2" CornerRadius="5" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
